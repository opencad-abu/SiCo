{
  "actions": {
    "check": {
      "capability": "calibre.lvs",
      "request": {
        "fields": [
          "run_ref", "config_path", "work_root",
          "candidate_path", "source_path", "bbox"
        ],
        "required": [
          "run_ref", "config_path", "work_root",
          "candidate_path", "source_path"
        ]
      },
      "response": {
        "schema": "calibre.lvs.check.v1"
      }
    },
    "export": {
      "capability": "calibre.lvs",
      "request": {
        "fields": ["export_ref", "config_path", "work_root"],
        "required": ["export_ref", "config_path", "work_root"]
      },
      "response": {
        "schema": "calibre.lvs.export.v1"
      }
    },
    "probe": {
      "capability": "calibre.lvs",
      "request": {
        "fields": ["tool_root"],
        "required": ["tool_root"]
      },
      "response": {
        "schema": "calibre.lvs.probe.v1"
      }
    },
    "result": {
      "capability": "calibre.lvs",
      "request": {
        "fields": ["run_ref", "offset", "limit"],
        "required": ["run_ref"]
      },
      "response": {
        "schema": "calibre.lvs.result.v1"
      }
    },
    "status": {
      "capability": "calibre.lvs",
      "request": {
        "fields": ["run_ref"],
        "required": ["run_ref"]
      },
      "response": {
        "schema": "calibre.lvs.status.v1"
      }
    },
    "submit": {
      "capability": "calibre.lvs",
      "request": {
        "fields": ["run_ref", "config_path", "work_root"],
        "required": ["run_ref", "config_path", "work_root"]
      },
      "response": {
        "schema": "calibre.lvs.submit.v1"
      }
    }
  },
  "errors": [
    "invalid_arguments",
    "unsupported_contract",
    "version_mismatch",
    "capability_not_available",
    "stale_context",
    "read_failed",
    "source_not_captured",
    "result_too_large",
    "timeout",
    "cancelled",
    "internal"
  ],
  "limits": {
    "max_bytes": 55000,
    "max_items": 200,
    "max_text": 4096
  },
  "name": "sico.calibre.lvs.v1",
  "version": 1
}
