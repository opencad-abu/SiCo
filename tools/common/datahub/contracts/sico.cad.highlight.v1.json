{
  "actions": {
    "highlight": {
      "capability": "aiSelectionHighlight",
      "request": {
        "fields": ["ref", "window_ref"],
        "required": ["ref", "window_ref"]
      },
      "response": {
        "schema": "cad.cv.highlight.v1"
      }
    }
  },
  "errors": [
    "invalid_arguments",
    "unsupported_contract",
    "version_mismatch",
    "capability_not_available",
    "source_not_captured",
    "stale_context",
    "stale_object",
    "ambiguous_target",
    "read_failed",
    "result_too_large",
    "timeout",
    "cancelled",
    "internal"
  ],
  "limits": {
    "max_bytes": 55000,
    "max_items": 1,
    "max_text": 4096
  },
  "name": "sico.cad.highlight.v1",
  "version": 1
}
