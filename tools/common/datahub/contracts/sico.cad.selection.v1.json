{
  "actions": {
    "inspect": {
      "capability": "aiSelectionInspect",
      "request": {
        "fields": ["window_ref", "offset", "limit"],
        "required": ["window_ref", "offset", "limit"]
      },
      "response": {
        "schema": "cad.cv.selection.v1"
      }
    }
  },
  "errors": [
    "invalid_arguments",
    "unsupported_contract",
    "version_mismatch",
    "capability_not_available",
    "source_not_captured",
    "stale_context",
    "read_failed",
    "result_too_large",
    "timeout",
    "cancelled",
    "internal"
  ],
  "limits": {
    "max_bytes": 55000,
    "max_items": 50,
    "max_text": 4096
  },
  "name": "sico.cad.selection.v1",
  "version": 1
}
