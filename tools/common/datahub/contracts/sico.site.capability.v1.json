{
  "actions": {
    "probe": {
      "capability": "site.python",
      "request": {
        "fields": ["scope"],
        "required": ["scope"]
      },
      "response": {
        "schema": "site.capability.v1"
      }
    }
  },
  "errors": [
    "invalid_arguments",
    "unsupported_contract",
    "version_mismatch",
    "capability_not_available",
    "read_failed",
    "result_too_large",
    "timeout",
    "cancelled",
    "internal"
  ],
  "limits": {
    "max_bytes": 55000,
    "max_items": 200,
    "max_text": 4096
  },
  "name": "sico.site.capability.v1",
  "version": 1
}
