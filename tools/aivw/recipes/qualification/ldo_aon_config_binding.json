{
  "schema_version": 1,
  "recipe_id": "ldo.aon_config_binding",
  "revision": 2,
  "purpose": "Read-only LDO_AON saved-source and official config-binding qualification; behavior fixtures are unused and no behavioral gate is defined.",
  "target": {
    "library": "amsLDO",
    "cell": "LDO_AON",
    "module": "LDO_AON",
    "source_views": {
      "schematic": "schematic",
      "symbol": "symbol",
      "config": "config"
    },
    "output_view": {
      "name": "rnm_candidate",
      "view_type": "systemVerilogText",
      "language": "systemverilog",
      "primary_file": "verilog.sv"
    }
  },
  "structure": {
    "provider": "cadence_si",
    "authoritative": true,
    "required_artifacts": [
      "netlist",
      "map",
      "globalmap",
      "netlister_log"
    ]
  },
  "inputs": {
    "interface_contract": "product:recipes/ldo/source_interface_contract.json",
    "behavior_spec": "product:recipes/ldo/behavior_spec.json",
    "correlation_policy": "product:recipes/ldo/correlation_policy.json"
  },
  "model": {
    "class": "ldo.linear_regulator",
    "generation": "ai_iterative",
    "template_policy": "registered_scaffold",
    "provenance_required": [
      "model",
      "model_version",
      "prompt_hash",
      "template_hashes",
      "context_hashes",
      "revision_parent",
      "feedback_hashes"
    ]
  },
  "workflow": {
    "gates": [
      {
        "id": "snapshot",
        "executor": "virtuoso.snapshot",
        "needs": []
      },
      {
        "id": "config_binding",
        "executor": "virtuoso.config_binding",
        "needs": [
          "snapshot"
        ]
      }
    ]
  },
  "verification": {
    "corner": {
      "process": "tt",
      "vdd": 5.0,
      "temperature_c": 27.0
    },
    "clock": {
      "edge": "rising",
      "sample_delay_seconds": 1e-06
    },
    "cases": [
      {
        "id": "nominal-in-window",
        "type": "supply_valid",
        "inputs": {
          "VDD": 5.0,
          "VSS": 0.0
        },
        "expected": {
          "vout": 2.5,
          "supply_current": 0.005,
          "enable_state": "active",
          "settling_time": 1e-06,
          "vout_waveform": [
            0.0,
            2.5
          ]
        },
        "assertions": [
          "vout",
          "supply_window"
        ]
      }
    ],
    "metrics": [
      {
        "name": "vout",
        "kind": "numeric",
        "unit": "V",
        "absolute_tolerance": 0.01
      },
      {
        "name": "supply_current",
        "kind": "numeric",
        "unit": "A",
        "absolute_tolerance": 1e-06
      },
      {
        "name": "enable_state",
        "kind": "categorical",
        "unit": "enum"
      },
      {
        "name": "settling_time",
        "kind": "timing",
        "unit": "s",
        "absolute_tolerance": 1e-06
      },
      {
        "name": "vout_waveform",
        "kind": "waveform",
        "unit": "V",
        "absolute_tolerance": 0.02
      }
    ],
    "l1": {
      "protocol": "AIVW_L1_EVENT v1 JSONL",
      "require_exact_case_set": true,
      "require_exact_metric_set": true,
      "require_assertion_pass": true,
      "minimum_case_coverage": 1.0,
      "required_metrics": [
        "vout",
        "supply_current",
        "enable_state",
        "settling_time",
        "vout_waveform"
      ],
      "required_checks": [
        "initial-state"
      ],
      "hold_case": "nominal-in-window"
    }
  },
  "live_update": {
    "triggers": [
      "manual"
    ],
    "formal_requires_saved": true,
    "debounce_ms": 750,
    "invalidation": {
      "schematic": [
        "snapshot",
        "config_binding"
      ],
      "config": [
        "snapshot",
        "config_binding"
      ]
    }
  },
  "publication": {
    "mode": "ipc_text_view",
    "allowed_languages": [
      "systemverilog"
    ],
    "optimistic_concurrency": true,
    "promotion": "human_approved",
    "symbol_update": "forbidden",
    "config_update": "forbidden",
    "restore_on_failure": true
  }
}
