  "verdict_policy": {
    "missing_evidence": "BLOCKED_EVIDENCE",
    "non_finite_evidence": "BLOCKED_EVIDENCE",
    "metric_mismatch": "FAIL_CORRELATION",
    "all_required_metrics": "PASS"
  },
  "reference_only": true
}
