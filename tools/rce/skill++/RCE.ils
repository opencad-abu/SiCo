; Development source bootstrap; protected runtimes use SICO_toolsInitialize.
let((commonSkill)
  commonSkill=strcat("/" buildString(reverse(cdr(reverse(
    parseString(simplifyFilename(get_filename(piport) t) "/")))) "/")
    "/../../common/skill/")
  load(strcat(commonSkill "SICO_environment.il"))
  load(strcat(commonSkill "SICO_installation.il")))

;------------------------------------------------------------------------------
; RCE frontend loader.
;------------------------------------------------------------------------------

unless(and(isCallable('cadCommonGuiModulesRevision)
             cadCommonGuiModulesRevision()=="20260924.common.environment.v3"
