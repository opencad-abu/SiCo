        ))
      when(ok
        rceFrontendLoaded=t)
      ok
    )
  )
)

)

rceToolsRoot=rceResolveToolsRoot()
rceSkillRoot=if(rceToolsRoot then
  simplifyFilename(strcat(rceToolsRoot "/rce") t))
rceCommonRoot=if(rceToolsRoot then
  simplifyFilename(strcat(rceToolsRoot "/common") t))
rceUtilityRoot=if(rceToolsRoot then
  simplifyFilename(strcat(rceToolsRoot "/utility") t))

if(and(rceSkillRoot rceCommonRoot rceUtilityRoot) then
  rceLoadFrontend()
else
  warn("RCE root is not configured. Set SICO_HOME; tools are expected under SICO_HOME/tools.\n")
)
