procedure(rceLoaderRevision()
  "20260924.flow.environment.v3"
)

procedure(rceResolveToolsRoot()
  SICO_installationPath(SICO_installationRoot() "tools"))

procedure(rceLoadFile(path)
  if(isFile(path) then
    load(path)
  else
    warn("RCE loader cannot find: %s\n" path)
    nil
  )
)

procedure(rceLoadBaseGui()
  if(and(isCallable('cadCommonGuiModulesRevision)
           cadCommonGuiModulesRevision()=="20260924.common.environment.v3"
           isCallable('cadBaseGuiRevision)
           cadBaseGuiRevision()=="20260721.case.sensitive.v2"
           isCallable('cadBaseMultiCornerRevision)
           cadBaseMultiCornerRevision()=="20260803.multi.corner.align.v4"
           isCallable('cadBaseInputRevision)
           cadBaseInputRevision()=="20260716.input.sync.v1"
           isCallable('cadCommonGuiModulesRevision)
           cadCommonGuiModulesRevision()=="20260924.common.environment.v3"
           isCallable('cadBaseHardwareRevision)
           cadBaseHardwareRevision()=="20260820.lsf.monitor.v7"
           isCallable('cadBaseLvsOptionsRevision)
           cadBaseLvsOptionsRevision()=="20260908.recognize.gates.v1"
           isCallable('cadBaseLvsCustomSvrfRevision)
           cadBaseLvsCustomSvrfRevision()=="20260812.custom.svrf.align.v2"
           isCallable('cadBaseRuleFileLabelRevision)
           cadBaseRuleFileLabelRevision()=="20260812.rule.file.label.v1"
           isCallable('cadBaseCdlIncludeRevision)
           cadBaseCdlIncludeRevision()=="20260812.cdl.include.v2"
           isCallable('rceGuiModulesRevision)
           rceGuiModulesRevision()=="20260919.gui.modules.v1"
           isCallable('rceBaseGuiRevision)
           rceBaseGuiRevision()=="20260909.pin.order.v1"
           isCallable('makeLayInp) isCallable('makeOutDir)
           isCallable('makeLvsHcell) isCallable('makeLvsCustomSvrf)
           isCallable('makeCustomSvrf) isCallable('cadCustomSvrfBind)
           isCallable('makeCdlInclude) isCallable('cadCdlIncludeCB)
           isCallable('cadCdlIncludeInputTypeCB)
           isCallable('makeNlOpt)) then
    cadBaseGuiLoaded=t
    t
  else
    let((ok)
      ok=and(rceLoadFile(strcat(rceCommonRoot "/skill++/BASEGUI.ils"))
          rceLoadFile(strcat(rceCommonRoot "/skill++/INPUTGUI.ils"))
          rceLoadFile(strcat(rceCommonRoot "/skill++/OUTPUTGUI.ils"))
          rceLoadFile(strcat(rceCommonRoot "/skill++/CUSTOMSVRFGUI.ils"))
          rceLoadFile(strcat(rceCommonRoot "/skill++/LVSOPTGUI.ils"))
          rceLoadFile(strcat(rceCommonRoot "/skill++/HARDWAREGUI.ils"))
          rceLoadFile(strcat(rceCommonRoot "/skill++/TOOLSETGUI.ils")))
      when(ok
        ok=rceLoadFile(strcat(rceSkillRoot "/skill++/RCEBASEGUI.ils")))
      when(ok
        ok=rceLoadFile(strcat(rceSkillRoot "/skill++/RCECORNERGUI.ils")))
      when(ok
        ok=rceLoadFile(strcat(rceSkillRoot "/skill++/RCESELECTIONGUI.ils")))
      when(ok
        ok=rceLoadFile(strcat(rceSkillRoot "/skill++/RCENETLISTGUI.ils")))
      when(ok
        ok=rceLoadFile(strcat(rceSkillRoot "/skill++/RCEEXTRACTGUI.ils")))
      when(ok
        cadBaseGuiLoaded=t)
      ok
    )
  )
)

procedure(rceLoadBatchSupport()
  if(and(isCallable('cadBatchGuiSharedRevision)
           isCallable('cadBatchAdapterRevision)
           cadBatchAdapterRevision()=="20260812.common.v1"
           cadBatchGuiSharedRevision()=="20260812.common.v1"
           isCallable('cadBatchRowsRevision)
           cadBatchRowsRevision()=="20260812.common.v1"
           isCallable('cadBatchCoreRevision)
           cadBatchCoreRevision()=="20260923.batch.commands.v3"
           isCallable('cadBatchMonitorRevision)
           cadBatchMonitorRevision()=="20260902.form.lifecycle.v1"
           isCallable('cadBatchMonitorAuditRevision)
           cadBatchMonitorAuditRevision()=="20260911.flow.audit.v1"
           isCallable('cadBatchGuiRevision)
           cadBatchGuiRevision()=="20260812.common.v1") then
    t
  else
    let((ok)
      ok=t
      foreach(path
        list(
          strcat(rceCommonRoot "/skill/SICO_batchAdapter.il")
          strcat(rceCommonRoot "/skill/SICO_batchGui.il")
          strcat(rceCommonRoot "/skill/SICO_batchRows.il")
          strcat(rceCommonRoot "/skill/SICO_batchCore.il")
          strcat(rceCommonRoot "/skill/SICO_batchMonitor.il")
          strcat(rceCommonRoot "/skill++/BATCHGUI.ils"))
        when(ok
          unless(rceLoadFile(path)
            ok=nil)))
      ok
    )
  )
)

