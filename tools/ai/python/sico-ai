#!/usr/bin/env python3

import sys
from pathlib import Path

# Development bootstrap only. Runtime installations execute the native ELF.
root = Path(__file__).resolve().parents[3]
for relative in ("tools/common/python", "tools/sico/python"):
    sys.path.insert(0, str(root / relative))

from cadai.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
