#!/bin/sh
# Development entry; distribution installs an ELF at the same path.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/tools/common/sh/sico-installation.sh"
sico_installation "$root"
sico_launcher_environment
sico_runtime_python || exit 2
python=$sico_runtime_python_value
exec "$python" -E -s -c '
import sys
sys.path.insert(0, sys.argv[1])
from sico_pinyin.cli import main
raise SystemExit(main(sys.argv[2:]))
' "$root/tools/common/python" "$@"
