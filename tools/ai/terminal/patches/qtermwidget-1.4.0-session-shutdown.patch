 void Session::close()
 {
     _autoClose = true;
     _wantedClose = true;
-    if (!_shellProcess->isRunning() || !sendSignal(SIGHUP)) {
-        // Forced close.
+
+    if (isRunning())
+    {
+        // Match other terminal emulators: try SIGHUP, close the PTY, then
+        // force the child down rather than leaving cleanup to its destructor.
+        if (sendSignal(SIGHUP))
+        {
+            return;
+        }
+
+        qWarning() << "Process" << processId() << "did not die with SIGHUP";
+        _shellProcess->closePty();
+        if (!_shellProcess->waitForFinished(1000) && !sendSignal(SIGKILL))
+        {
+            qWarning() << "Process" << processId() << "did not die with SIGKILL";
+            QTimer::singleShot(1, this, SIGNAL(finished()));
+        }
+    }
+    else
+    {
+        // The process has already finished; only the session needs closing.
         QTimer::singleShot(1, this, SIGNAL(finished()));
     }
 }
