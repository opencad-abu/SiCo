@@ -1,12 +1,26 @@
 #include "tools.h"
 
 #include <QCoreApplication>
 #include <QDir>
+#include <QFile>
 #include <QtDebug>
 
 
 Q_LOGGING_CATEGORY(qtermwidgetLogger, "qtermwidget", QtWarningMsg)
 
+QString get_qtermwidget_data_dir(const QString& subdirectory)
+{
+    const QByteArray configured = qgetenv("SICO_AI_QTERMWIDGET_DATA_PATH");
+    if (configured.isEmpty())
+        return QString();
+
+    const QDir root(QFile::decodeName(configured));
+    const QDir directory(root.absoluteFilePath(subdirectory));
+    if (!directory.exists())
+        return QString();
+    return directory.absolutePath();
+}
