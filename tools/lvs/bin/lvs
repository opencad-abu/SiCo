#!/bin/sh
set -eu

program=lvs
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
product_root=$(CDPATH='' cd -- "$script_dir/../../.." && pwd -P)
. "$product_root/tools/common/sh/sico-installation.sh"
sico_installation "$product_root" || exit 2
sico_launcher_environment || exit 2
flow_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
entry=$flow_root/python/lvs

if [ ! -f "$entry" ]; then
    echo "$program: Python entry is unavailable: $entry" >&2
    exit 2
fi

python=${LVS_PYTHON-}
if [ -z "$python" ]; then
    sico_runtime_python || exit 2
    python=$sico_runtime_python_value
fi

case $python in
    */*) [ -f "$python" ] && [ -x "$python" ] ;;
    *) command -v "$python" >/dev/null 2>&1 ;;
esac || {
    echo "$program: Python is not executable: $python" >&2
    exit 2
}

if [ -z "${LVS_ORIG_LD_LIBRARY_PATH+x}" ]; then
    export LVS_ORIG_LD_LIBRARY_PATH=${LD_LIBRARY_PATH-}
fi
sico_runtime_library_path flow
export LD_LIBRARY_PATH=$sico_runtime_library_path_value
export PYTHONDONTWRITEBYTECODE=1
export PYTHONNOUSERSITE=1
unset PYTHONHOME PYTHONPATH LD_PRELOAD LD_AUDIT
exec "$python" -s "$entry" "$@"
