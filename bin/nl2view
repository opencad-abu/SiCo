#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
product_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
. "$product_root/tools/common/sh/sico-installation.sh"
sico_installation "$product_root"
sico_launcher_environment
common_python=$SICO_HOME/tools/common/python

sico_runtime_python || exit 2
python=$sico_runtime_python_value

if [ -z "${NL2VIEW_ORIG_LD_LIBRARY_PATH+x}" ]; then
    export NL2VIEW_ORIG_LD_LIBRARY_PATH=${LD_LIBRARY_PATH-}
fi
sico_runtime_library_path flow
export LD_LIBRARY_PATH=$sico_runtime_library_path_value
export PYTHONNOUSERSITE=1
unset PYTHONHOME
unset LD_PRELOAD LD_AUDIT
unset CDS_MPS_SESSION CDS_MPS_HOST CDS_MPS_PORT
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH=${common_python}${PYTHONPATH:+:${PYTHONPATH}}
exec "$python" -s -m cadview.nl2view "$@"
