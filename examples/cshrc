# SiCo 环境设置参考（Csh/Tcsh）。先加载站点 Cadence/LSF 环境，再 source 本文件。
# 使用前修改 SICO_HOME；使用 MTS 时还需配置下方 MTS_NETLISTOR_MODULEFILES。
# 在启动 Virtuoso 前 source 本文件；切换安装后，新开 shell 和工程服务才会使用新配置。
# 示例：source /software/sico/latest/examples/cshrc

# SiCo 安装根：二进制测试选 latest-bin；源码测试可改为 /software/sico/latest。
setenv SICO_HOME "/software/sico/latest-bin"

if ( -f "$SICO_HOME/scripts/sicoAutoLoad.il" ) then
    # 源码树使用站点 Python；按实际安装路径修改，需包含 SiCo 所需的 Qt 等依赖。
    setenv SICO_PYTHON_ROOT "/software/pkgs/python/3.9.13"
    # 源码树的终端 Python 实现目录。
    setenv SICO_AI_PYQT_ROOT "$SICO_HOME/tools/ai/terminal/pyqt"
else
    # 二进制包使用本安装自带的 Python runtime。
    setenv SICO_PYTHON_ROOT "$SICO_HOME/runtime/python"
    # 清除上一份源码安装的终端目录覆盖。
    unsetenv SICO_AI_PYQT_ROOT
endif

# EDA 兼容库只使用本安装的 lib；Python/Qt 的库目录仍由下方独立变量传递。
if ( $?LD_LIBRARY_PATH ) then
    setenv LD_LIBRARY_PATH "${SICO_HOME}/lib:${LD_LIBRARY_PATH}"
else
    setenv LD_LIBRARY_PATH "$SICO_HOME/lib"
endif

# Python 可执行文件，供 SiCo 及其子进程使用。
setenv SICO_PYTHON "$SICO_PYTHON_ROOT/bin/python3"
# SiCo Python/Qt 的动态库目录；不直接改 LD_LIBRARY_PATH，以免影响 Virtuoso。
setenv SICO_SYSTEM_LD_LIBRARY_PATH "${SICO_PYTHON_ROOT}/lib:${SICO_HOME}/lib"
# AI 窗口和终端使用同一组 Python 动态库。
setenv SICO_AI_PYTHON_LIBRARY_PATH "$SICO_SYSTEM_LD_LIBRARY_PATH"
# SKILL/runtime 查找工具实现的目录，与 SICO_HOME 保持一致。
setenv SICO_RUNTIME_TOOLS "$SICO_HOME/tools"
# 公共命令目录，提供 sico、sico-ai-terminal、lsfmonitor 等命令。
setenv PATH "${SICO_HOME}/bin:${PATH}"

# 清除旧安装的终端运行库、发行根、context 和 Qt 插件路径覆盖，改由当前安装解析。
unsetenv SICO_AI_QTERMWIDGET_RUNTIME
unsetenv SICO_AI_RELEASE_ROOT
unsetenv SICO_AI_CONTEXT
unsetenv SICO_AI_QT_PLUGIN_PATH

